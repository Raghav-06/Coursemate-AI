# ============================================================================
#  Ask AI — backend environment
#  Copy to .env and fill in every value marked REQUIRED
# ============================================================================

# ---- Server ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Where the React app runs. OAuth redirects back here after sign-in.
# Dev: the Vite server. Production: your public site URL (e.g. https://askai.example.com)
CLIENT_URL=http://localhost:5173

# ---- PostgreSQL (pg) -------------------------------------------------------
# Either a single connection string...
# REQUIRED (or fill the PG* values below)
DATABASE_URL=
# e.g. postgresql://postgres:password@localhost:5432/askai
# ...or the individual settings (used only when DATABASE_URL is empty):
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=askai
# Set PGSSL=true for hosted databases (Neon, Supabase, Render, RDS…)
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=10

# ---- Google OAuth ----------------------------------------------------------
# Optional if you only want email sign-in (the Google button will show an error until set).
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# (type "Web application"). Add the callback below as an Authorized redirect URI
# and http://localhost:5173 as an Authorized JavaScript origin.
# REQUIRED for Google sign-in
GOOGLE_CLIENT_ID=
# REQUIRED for Google sign-in
GOOGLE_CLIENT_SECRET=
# Dev: goes through the Vite proxy so the session cookie lands on the app's origin.
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback
# Optional: only allow these email domains to sign in (comma-separated). Empty = anyone.
ALLOWED_EMAIL_DOMAINS=

# ---- Sessions --------------------------------------------------------------
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=30
SESSION_COOKIE_NAME=askai.sid
# true when served over HTTPS (defaults to true when NODE_ENV=production)
COOKIE_SECURE=false
# lax works when frontend and backend share a site; use "none" (+ COOKIE_SECURE=true)
# if they are on different domains.
COOKIE_SAME_SITE=lax

# ---- Email + password sign-in (SMTP) ----------------------------------------
# Users who don't want Google enter their email, get a 6-digit code, then set a password.
# Leave SMTP_HOST empty in development to print the codes in the server console instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=you@gmail.com,
#        SMTP_PASS=<16-char App Password from https://myaccount.google.com/apppasswords>
# Other options: SendGrid, Mailgun, Amazon SES, Brevo, Resend (all offer SMTP).
# REQUIRED in production
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown in the inbox, e.g. Ask AI <no-reply@yourdomain.com>
MAIL_FROM=
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
PASSWORD_MIN_LENGTH=8

# ---- AI: any model provider (through LangChain) ------------------------------
# Chat and embeddings are configured separately, so you can mix providers
# (e.g. chat on Anthropic or Groq, embeddings on OpenAI or Gemini).
#
# Chat works with any provider that offers an OpenAI-compatible API. Set
# CHAT_BASE_URL to your provider's URL:
#   Provider       CHAT_BASE_URL                                              Example CHAT_MODEL
#   OpenAI         https://api.openai.com/v1                                  gpt-4o-mini
#   Anthropic      https://api.anthropic.com/v1/                              claude-sonnet-5-5
#   Google Gemini  https://generativelanguage.googleapis.com/v1beta/openai    gemini-2.5-flash
#   Groq           https://api.groq.com/openai/v1                             llama-3.3-70b-versatile
#   OpenRouter     https://openrouter.ai/api/v1                               meta-llama/llama-3.3-70b-instruct
#   Mistral        https://api.mistral.ai/v1                                  mistral-small-latest
#   Together AI    https://api.together.xyz/v1                                meta-llama/Llama-3.3-70B-Instruct-Turbo
#   DeepSeek       https://api.deepseek.com/v1                                deepseek-chat
#   xAI            https://api.x.ai/v1                                        grok-3-mini
#   Hugging Face   https://router.huggingface.co/v1                           meta-llama/Llama-3.1-8B-Instruct
#   Ollama (local) http://localhost:11434/v1                                  llama3.1
#   LM Studio      http://localhost:1234/v1                                   <loaded model name>

# --- Chat model: answers, source guides and notebook overviews ---
# REQUIRED (except for local servers such as Ollama / LM Studio)
CHAT_API_KEY=
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
# Optional. Leave empty to use the provider's default (some reasoning models,
# e.g. OpenAI o-series / gpt-5, reject a custom temperature).
CHAT_TEMPERATURE=0.3
CHAT_MAX_TOKENS=4096

# --- Embedding model: turns your sources into vectors for search ---
# EMBEDDING_PROVIDER:
#   openai      — any OpenAI-compatible /embeddings API (OpenAI, Gemini, Mistral,
#                 Together, Jina, Ollama, LM Studio…)
#   huggingface — Hugging Face feature extraction (e.g. BAAI/bge-small-en-v1.5)
#   Provider       EMBEDDING_BASE_URL                                         Example EMBEDDING_MODEL
#   OpenAI         https://api.openai.com/v1                                  text-embedding-3-small
#   Google Gemini  https://generativelanguage.googleapis.com/v1beta/openai    gemini-embedding-001
#   Mistral        https://api.mistral.ai/v1                                  mistral-embed
#   Together AI    https://api.together.xyz/v1                                BAAI/bge-base-en-v1.5
#   Ollama (local) http://localhost:11434/v1                                  nomic-embed-text
#   Hugging Face   (leave empty, or a dedicated Inference Endpoint URL)       BAAI/bge-small-en-v1.5
# Anthropic, Groq, DeepSeek and xAI have no embedding API, so pick another provider here.
# Changing the embedding model re-embeds existing sources automatically.
EMBEDDING_PROVIDER=openai
# Leave empty to reuse CHAT_API_KEY (when chat and embeddings use the same provider).
EMBEDDING_API_KEY=
# Leave empty to reuse CHAT_BASE_URL (provider "openai" only).
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
# Optional: shorter vectors, for models that support it (e.g. text-embedding-3-*).
EMBEDDING_DIMENSIONS=
# Texts sent per embedding request.
EMBEDDING_BATCH_SIZE=32

# ---- Retrieval & limits ----------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MMR_K=8
MMR_FETCH_K=30
MMR_LAMBDA=0.6
MAX_SOURCES_PER_NOTEBOOK=50
# How many sources' vectors to keep in memory (least recently used are dropped and reloaded from Postgres)
VECTOR_CACHE_MAX_SOURCES=200
UPLOAD_MAX_MB=200
CHAT_HISTORY_MESSAGES=6
# true lets URL sources point at localhost / private networks (dev only)
ALLOW_PRIVATE_URLS=false

# ---- Paths -----------------------------------------------------------------
# Temporary folder for uploads while their text is extracted
UPLOAD_DIR=./uploads
# Built frontend that Express serves when NODE_ENV=production
CLIENT_DIST_DIR=../frontend/dist
