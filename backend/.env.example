# ============================================================================
#  CourseMate AI — backend environment
#  Copy to .env and fill in every value marked REQUIRED. Every variable the
#  backend reads is listed here; empty = the default described next to it.
# ============================================================================

# ---- Server ----------------------------------------------------------------
# development | production (production: secure cookies, serves the built frontend; seed:demo refuses to run)
NODE_ENV=development
# Port the API listens on
PORT=3000
# Where the React app runs; OAuth redirects back here and CORS allows it (production: your public URL)
CLIENT_URL=http://localhost:5173

# ---- PostgreSQL (pg) -------------------------------------------------------
# REQUIRED (or the PG* values below): full connection string, e.g. postgresql://postgres:password@localhost:5432/coursemate
DATABASE_URL=
# Database host (used only when DATABASE_URL is empty)
PGHOST=127.0.0.1
# Database port
PGPORT=5432
# Database user
PGUSER=postgres
# Database password
PGPASSWORD=
# Database name
PGDATABASE=coursemate
# true for hosted databases that need SSL (Neon, Supabase, Render, RDS…)
PGSSL=false
# false accepts self-signed database certificates
PGSSL_REJECT_UNAUTHORIZED=true
# Connections in the pool
PG_POOL_MAX=10

# ---- Google OAuth (optional: email sign-in works without it) ----------------
# REQUIRED for Google sign-in: OAuth client ID (Google Cloud Console → Credentials → Web application)
GOOGLE_CLIENT_ID=
# REQUIRED for Google sign-in: OAuth client secret
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI (dev: through the Vite proxy so the cookie lands on the app's origin)
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback
# Only these email domains may sign in, comma-separated (empty = anyone)
ALLOWED_EMAIL_DOMAINS=

# ---- Sessions --------------------------------------------------------------
# REQUIRED: long random string — node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Days a sign-in lasts
SESSION_MAX_AGE_DAYS=30
# Name of the session cookie
SESSION_COOKIE_NAME=askai.sid
# true when served over HTTPS (default: true in production)
COOKIE_SECURE=false
# lax when frontend and backend share a site; none (+ COOKIE_SECURE=true) across domains
COOKIE_SAME_SITE=lax

# ---- Email + password sign-in (SMTP) ----------------------------------------
# REQUIRED in production: SMTP server (empty in dev = codes are printed in the server console)
SMTP_HOST=
# SMTP port (465 = SSL, 587 = STARTTLS)
SMTP_PORT=587
# true for port 465
SMTP_SECURE=false
# SMTP user name (Gmail: your address)
SMTP_USER=
# SMTP password (Gmail: a 16-character App Password)
SMTP_PASS=
# Sender shown in the inbox, e.g. CourseMate AI <no-reply@yourdomain.com>
MAIL_FROM=
# Minutes a verification code stays valid
EMAIL_CODE_TTL_MINUTES=10
# Seconds before a new code can be requested
EMAIL_CODE_RESEND_SECONDS=60
# Wrong tries allowed per code
EMAIL_CODE_MAX_ATTEMPTS=5
# Shortest password allowed
PASSWORD_MIN_LENGTH=8

# ---- AI: one shared provider ------------------------------------------------
# Every AI job (LLM, embeddings, vision, transcription, model tiers) uses these
# unless it has its own settings below. Provider names fill in the base URL:
#   openai, anthropic, gemini, groq, openrouter, mistral, together, deepseek,
#   xai, huggingface (https://router.huggingface.co/v1), ollama
#   (http://localhost:11434/v1), lmstudio (http://localhost:1234/v1), or custom
#   (any OpenAI-compatible server; set AI_BASE_URL). README.md has full examples.
# Provider name (default openai)
AI_PROVIDER=openai
# REQUIRED except for local servers (Ollama, LM Studio…): the provider's API key
AI_API_KEY=
# Overrides the provider's base URL (required for custom)
AI_BASE_URL=

# ---- LLM: chat, guides, flashcards, quizzes, grading, plans -----------------
# REQUIRED unless AI_PROVIDER=openai (default gpt-4o-mini): chat model id
LLM_MODEL=gpt-4o-mini
# Sampling temperature (empty = the provider's default; some reasoning models reject one)
LLM_TEMPERATURE=0.3
# Longest reply in tokens (empty = the provider's default)
LLM_MAX_TOKENS=4096
# A different provider just for the LLM (empty = AI_PROVIDER)
LLM_PROVIDER=
# Its API key (empty = AI_API_KEY when the URL is the shared one)
LLM_API_KEY=
# Its base URL (empty = the provider's default)
LLM_BASE_URL=
# Older names, still read when the LLM_* / AI_* ones are empty:
# CHAT_PROVIDER=     (legacy alias of LLM_PROVIDER)
# CHAT_API_KEY=      (legacy alias of AI_API_KEY / LLM_API_KEY)
# CHAT_BASE_URL=     (legacy alias of AI_BASE_URL / LLM_BASE_URL)
# CHAT_MODEL=        (legacy alias of LLM_MODEL)
# CHAT_TEMPERATURE=  (legacy alias of LLM_TEMPERATURE)
# CHAT_MAX_TOKENS=   (legacy alias of LLM_MAX_TOKENS)

# ---- Embeddings: vectors for search and citations ---------------------------
# Provider (empty = AI_PROVIDER; huggingface = HF feature extraction). Anthropic, Groq, DeepSeek and xAI have none.
EMBEDDING_PROVIDER=
# Its API key (empty = AI_API_KEY when the provider is the shared one)
EMBEDDING_API_KEY=
# Its base URL (huggingface: optional dedicated Inference Endpoint)
EMBEDDING_BASE_URL=
# Embedding model id (changing it re-embeds sources on their next chat)
EMBEDDING_MODEL=text-embedding-3-small
# Shorter vectors, for models that support it (empty = the model's size)
EMBEDDING_DIMENSIONS=
# Texts sent per embedding request
EMBEDDING_BATCH_SIZE=32

# ---- Vision: photos of handwritten notes and scanned PDFs -------------------
# Provider (empty = AI_PROVIDER)
VISION_PROVIDER=
# Its API key (empty = AI_API_KEY when the provider is the shared one)
VISION_API_KEY=
# Its base URL (empty = the provider's default)
VISION_BASE_URL=
# A model that accepts images (empty = LLM_MODEL)
VISION_MODEL=
# Scanned PDF pages read per source (one vision request each)
VISION_MAX_PAGES=60

# ---- Transcription: lecture recordings --------------------------------------
# Provider with an OpenAI-compatible /audio/transcriptions (empty = AI_PROVIDER)
TRANSCRIBE_PROVIDER=
# Its API key (empty = AI_API_KEY when the provider is the shared one)
TRANSCRIBE_API_KEY=
# Its base URL (empty = the provider's default)
TRANSCRIBE_BASE_URL=
# Speech-to-text model (empty = whisper-1; Groq: whisper-large-v3-turbo)
TRANSCRIBE_MODEL=
# Recordings are split into pieces below this many MB (OpenAI and Groq accept 25)
TRANSCRIBE_MAX_MB=24
# Path to your own ffmpeg binary (empty = the one from ffmpeg-static)
FFMPEG_PATH=

# ---- Exam-prep agent model tiers: Nano, Super, Ultra ------------------------
# Nano = quick judgement (objective grading, topic tagging, sorting uploads);
# Super = writing and self-checking questions, descriptive grading, daily replans;
# Ultra = mistake diagnosis, the knowledge map, the weekly plan.
# Empty settings fall back to the LLM ones. Task → tier map: src/services/modelRouter.js.
# Nano: OpenAI-compatible base URL (empty = the LLM's)
MODEL_NANO_BASE_URL=
# Nano: API key (needed only when the base URL differs from the LLM's)
MODEL_NANO_API_KEY=
# Nano: model id (empty = LLM_MODEL)
MODEL_NANO_MODEL=
# Nano: temperature (empty = LLM_TEMPERATURE; "default" = the provider's)
MODEL_NANO_TEMPERATURE=
# Nano: max reply tokens (empty = LLM_MAX_TOKENS; "default" = the provider's)
MODEL_NANO_MAX_TOKENS=
# Nano: line put before the system prompt, e.g. "/no_think" (empty = none)
MODEL_NANO_SYSTEM_PREFIX=
# Super: OpenAI-compatible base URL (empty = the LLM's)
MODEL_SUPER_BASE_URL=
# Super: API key (needed only when the base URL differs from the LLM's)
MODEL_SUPER_API_KEY=
# Super: model id (empty = LLM_MODEL)
MODEL_SUPER_MODEL=
# Super: temperature (empty = LLM_TEMPERATURE; "default" = the provider's)
MODEL_SUPER_TEMPERATURE=
# Super: max reply tokens (empty = LLM_MAX_TOKENS; "default" = the provider's)
MODEL_SUPER_MAX_TOKENS=
# Super: line put before the system prompt (empty = none)
MODEL_SUPER_SYSTEM_PREFIX=
# Ultra: OpenAI-compatible base URL (empty = the LLM's)
MODEL_ULTRA_BASE_URL=
# Ultra: API key (needed only when the base URL differs from the LLM's)
MODEL_ULTRA_API_KEY=
# Ultra: model id (empty = LLM_MODEL)
MODEL_ULTRA_MODEL=
# Ultra: temperature (empty = LLM_TEMPERATURE; "default" = the provider's)
MODEL_ULTRA_TEMPERATURE=
# Ultra: max reply tokens (empty = LLM_MAX_TOKENS; "default" = the provider's)
MODEL_ULTRA_MAX_TOKENS=
# Ultra: line put before the system prompt, e.g. "detailed thinking on" (empty = none)
MODEL_ULTRA_SYSTEM_PREFIX=

# ---- Retrieval & limits ----------------------------------------------------
# Characters per chunk when splitting sources
CHUNK_SIZE=1000
# Characters shared by neighbouring chunks
CHUNK_OVERLAP=200
# Passages retrieved per answer
MMR_K=8
# Candidates considered before MMR picks diverse passages
MMR_FETCH_K=30
# MMR balance: 1 = most relevant, 0 = most diverse
MMR_LAMBDA=0.6
# Sources per course
MAX_SOURCES_PER_NOTEBOOK=50
# Units (chapters / modules) per course
MAX_UNITS_PER_NOTEBOOK=50
# New flashcards each user starts per course per day (due reviews are never capped)
NEW_CARDS_PER_DAY=20
# Sources whose vectors stay in memory (least recently used are reloaded from Postgres)
VECTOR_CACHE_MAX_SOURCES=200
# People per shared course (owner included)
MAX_MEMBERS_PER_COURSE=50
# Days an invite link stays valid
INVITE_TTL_DAYS=14
# Players per quiz battle
MAX_BATTLE_PLAYERS=30
# Largest upload in MB (also lecture recordings)
UPLOAD_MAX_MB=200
# Earlier chat messages sent with each question for context
CHAT_HISTORY_MESSAGES=6
# true lets URL sources point at localhost / private networks (dev only)
ALLOW_PRIVATE_URLS=false

# ---- Paths -----------------------------------------------------------------
# Temporary folder for uploads while their text is extracted
UPLOAD_DIR=./uploads
# Where original uploads are kept for re-processing (empty = <UPLOAD_DIR>/originals)
ORIGINALS_DIR=
# Built frontend that Express serves when NODE_ENV=production
CLIENT_DIST_DIR=../frontend/dist
