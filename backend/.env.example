# ============================================================================
#  CourseMate AI — backend environment
#  Copy to .env and fill in every value marked REQUIRED
# ============================================================================

# ---- Server ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Where the React app runs. OAuth redirects back here after sign-in.
# Dev: the Vite server. Production: your public site URL (e.g. https://coursemate.example.com)
CLIENT_URL=http://localhost:5173

# ---- PostgreSQL (pg) -------------------------------------------------------
# Either a single connection string...
# REQUIRED (or fill the PG* values below)
DATABASE_URL=
# e.g. postgresql://postgres:password@localhost:5432/askai
# ...or the individual settings (used only when DATABASE_URL is empty):
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=askai
# Set PGSSL=true for hosted databases (Neon, Supabase, Render, RDS…)
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=10

# ---- Google OAuth ----------------------------------------------------------
# Optional if you only want email sign-in (the Google button will show an error until set).
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# (type "Web application"). Add the callback below as an Authorized redirect URI
# and http://localhost:5173 as an Authorized JavaScript origin.
# REQUIRED for Google sign-in
GOOGLE_CLIENT_ID=
# REQUIRED for Google sign-in
GOOGLE_CLIENT_SECRET=
# Dev: goes through the Vite proxy so the session cookie lands on the app's origin.
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback
# Optional: only allow these email domains to sign in (comma-separated). Empty = anyone.
ALLOWED_EMAIL_DOMAINS=

# ---- Sessions --------------------------------------------------------------
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=30
SESSION_COOKIE_NAME=askai.sid
# true when served over HTTPS (defaults to true when NODE_ENV=production)
COOKIE_SECURE=false
# lax works when frontend and backend share a site; use "none" (+ COOKIE_SECURE=true)
# if they are on different domains.
COOKIE_SAME_SITE=lax

# ---- Email + password sign-in (SMTP) ----------------------------------------
# Users who don't want Google enter their email, get a 6-digit code, then set a password.
# Leave SMTP_HOST empty in development to print the codes in the server console instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=you@gmail.com,
#        SMTP_PASS=<16-char App Password from https://myaccount.google.com/apppasswords>
# Other options: SendGrid, Mailgun, Amazon SES, Brevo, Resend (all offer SMTP).
# REQUIRED in production
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown in the inbox, e.g. CourseMate AI <no-reply@yourdomain.com>
MAIL_FROM=
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
PASSWORD_MIN_LENGTH=8

# ---- AI: any model provider (through LangChain) ------------------------------
# Set ONE provider below and every AI job uses it: the LLM (chat, guides,
# flashcards, quizzes, grading, plans), embeddings (search), vision (photos /
# scanned PDFs) and transcription (lecture recordings).
# Any job can use a different provider with its own <JOB>_PROVIDER /
# <JOB>_API_KEY / <JOB>_BASE_URL (JOB = LLM, EMBEDDING, VISION, TRANSCRIBE).
#
#   AI_PROVIDER   Default base URL (filled in for you)                 Example LLM_MODEL
#   openai        https://api.openai.com/v1                            gpt-4o-mini
#   anthropic     https://api.anthropic.com/v1                         claude-sonnet-5-5
#   gemini        https://generativelanguage.googleapis.com/v1beta/openai   gemini-2.5-flash
#   groq          https://api.groq.com/openai/v1                       llama-3.3-70b-versatile
#   openrouter    https://openrouter.ai/api/v1                         meta-llama/llama-3.3-70b-instruct
#   mistral       https://api.mistral.ai/v1                            mistral-small-latest
#   together      https://api.together.xyz/v1                          meta-llama/Llama-3.3-70B-Instruct-Turbo
#   deepseek      https://api.deepseek.com/v1                          deepseek-chat
#   xai           https://api.x.ai/v1                                  grok-3-mini
#   huggingface   https://router.huggingface.co/v1                     meta-llama/Llama-3.1-8B-Instruct
#   ollama        http://localhost:11434/v1   (local, no key)          llama3.1
#   lmstudio      http://localhost:1234/v1    (local, no key)          <loaded model name>
#   custom        any other OpenAI-compatible server: set AI_BASE_URL
#
# Anthropic, Groq, DeepSeek and xAI have no embeddings API: with those, set
# EMBEDDING_PROVIDER (and EMBEDDING_API_KEY) to another provider below.

# --- Shared provider (used by every job unless overridden) ---
AI_PROVIDER=openai
# REQUIRED (except for local servers such as Ollama / LM Studio)
AI_API_KEY=
# Optional: overrides the provider's default URL (required for "custom").
AI_BASE_URL=

# --- LLM: answers, source guides, course overviews, flashcards, quizzes, grading ---
# REQUIRED unless AI_PROVIDER=openai (default gpt-4o-mini)
LLM_MODEL=gpt-4o-mini
# Optional. Leave empty to use the provider's default (some reasoning models,
# e.g. OpenAI o-series / gpt-5, reject a custom temperature).
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
# Optional: a different provider just for the LLM (empty = the shared one above).
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=

# --- Embeddings: turn your sources into vectors for search ---
#   EMBEDDING_PROVIDER  Example EMBEDDING_MODEL
#   openai              text-embedding-3-small
#   gemini              gemini-embedding-001
#   mistral             mistral-embed
#   together            BAAI/bge-base-en-v1.5
#   ollama              nomic-embed-text
#   lmstudio            <loaded embedding model name>
#   huggingface         BAAI/bge-small-en-v1.5  (Hugging Face feature extraction;
#                       EMBEDDING_BASE_URL = optional dedicated Inference Endpoint)
# Changing the embedding model re-embeds existing sources automatically.
# Empty provider / key / URL = the shared AI_* settings.
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
# Optional: shorter vectors, for models that support it (e.g. text-embedding-3-*).
EMBEDDING_DIMENSIONS=
# Texts sent per embedding request.
EMBEDDING_BATCH_SIZE=32

# --- Vision: reads photos of handwritten notes, whiteboards and scanned PDFs ---
# Any model that accepts images (gpt-4o-mini, gemini-2.5-flash, claude-sonnet-5-5,
# llama-4-scout on Groq, qwen2.5vl / llava on Ollama…).
# Empty provider / key / URL = the shared AI_* settings; empty model = LLM_MODEL.
VISION_PROVIDER=
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
# Scanned PDF pages read per source (one vision request per page)
VISION_MAX_PAGES=60

# --- Transcription: turns lecture recordings (audio / video) into text with timestamps ---
# Any OpenAI-compatible /audio/transcriptions API that returns verbose_json:
#   TRANSCRIBE_PROVIDER  TRANSCRIBE_MODEL
#   openai               whisper-1
#   groq                 whisper-large-v3-turbo
# Empty provider / key / URL = the shared AI_* settings. Model defaults to whisper-1.
TRANSCRIBE_PROVIDER=
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=
TRANSCRIBE_MODEL=
# Recordings are split into pieces below this size (OpenAI and Groq accept up to 25 MB)
TRANSCRIBE_MAX_MB=24
# Optional: path to your own ffmpeg binary (default: the one bundled with ffmpeg-static)
FFMPEG_PATH=

# ---- Retrieval & limits ----------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MMR_K=8
MMR_FETCH_K=30
MMR_LAMBDA=0.6
MAX_SOURCES_PER_NOTEBOOK=50
# Units (chapters / modules) a course can be split into
MAX_UNITS_PER_NOTEBOOK=50
# New flashcards each user starts per course per day (due reviews are never capped)
NEW_CARDS_PER_DAY=20
# How many sources' vectors to keep in memory (least recently used are dropped and reloaded from Postgres)
VECTOR_CACHE_MAX_SOURCES=200
# Shared courses: people per course (owner included) and days an invite link stays valid
MAX_MEMBERS_PER_COURSE=50
INVITE_TTL_DAYS=14
# Players per quiz battle
MAX_BATTLE_PLAYERS=30
# Largest file a user can upload (also applies to lecture recordings)
UPLOAD_MAX_MB=200
CHAT_HISTORY_MESSAGES=6
# true lets URL sources point at localhost / private networks (dev only)
ALLOW_PRIVATE_URLS=false

# ---- Paths -----------------------------------------------------------------
# Temporary folder for uploads while their text is extracted
UPLOAD_DIR=./uploads
# Where original uploaded files are kept (so sources can be re-processed). Default: <UPLOAD_DIR>/originals
ORIGINALS_DIR=
# Built frontend that Express serves when NODE_ENV=production
CLIENT_DIST_DIR=../frontend/dist
